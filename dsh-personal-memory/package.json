{
  "name": "dsh-personal-memory",
  "version": "1.3.0",
  "description": "个人记忆面板：personal 认知 + memory 时间长河 + 会话时间线，一个插件一张脑图（笔记小节与会话 turn 都是节点）",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./brain/panel/index.html": "./brain/panel/index.html"
  },
  "files": [
    "index.js",
    "guard.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "lib",
    "brain",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "journal",
    "kb-audit",
    "knowledge-base",
    "memory",
    "note-health",
    "panel",
    "personal-memory",
    "rag",
    "recall"
  ],
  "license": "MIT",
  "author": "codeSlay404",
  "homepage": "https://github.com/codeSlay404/dsh-plug-in/tree/main/dsh-personal-memory#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeSlay404/dsh-plug-in.git",
    "directory": "dsh-personal-memory"
  },
  "bugs": {
    "url": "https://github.com/codeSlay404/dsh-plug-in/issues"
  },
  "scripts": {
    "check": "node smoke.mjs && node smoke-client.mjs && node check-props.mjs && node smoke-panel.mjs && node smoke-render.mjs && node smoke-brain.mjs",
    "check:live": "node smoke-live.mjs",
    "preview": "node preview.mjs --all",
    "check:brain": "node smoke-brain.mjs"
  }
}
