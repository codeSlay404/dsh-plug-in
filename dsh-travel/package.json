{
  "name": "dsh-travel",
  "version": "1.0.0",
  "description": "旅行灵感面板:按当季/四季推荐目的地,重点写「当地最好玩的事」(玩法、吃法、贴士,不只是景点),支持玩法筛选、搜索、随机灵感与想去收藏",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "guard.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "travel",
    "seasons",
    "trip",
    "panel"
  ],
  "license": "MIT",
  "author": "codeSlay404",
  "homepage": "https://github.com/codeSlay404/dsh-plug-in/tree/main/dsh-travel#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/codeSlay404/dsh-plug-in.git",
    "directory": "dsh-travel"
  },
  "bugs": {
    "url": "https://github.com/codeSlay404/dsh-plug-in/issues"
  }
}
